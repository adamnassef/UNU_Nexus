# Local: copy this file to .env.local and fill in values.
#   cp .env.example .env.local
# Production: Vercel → Project → Settings → Environment Variables
#   (same names for Production and Preview).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Never put the service_role key in VITE_* — it would ship to every browser.
# Use the anon (public) key only in the frontend.

# Local `npm run dev` chat fallback ONLY. Production builds fail if this is set.
# VITE_ANTHROPIC_API_KEY=

# Skip magic-link login while running `npm run dev` (ignored / blocked in production)
# VITE_DEV_BYPASS_AUTH=true

# After first deploy: run supabase/schema.sql, supabase/permissions.sql, then
# supabase/security.sql in the SQL Editor. Deploy Edge Functions:
#   supabase functions deploy chat
#   supabase functions deploy admin
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set ALLOWED_ORIGINS=https://YOUR_APP.vercel.app
#
# Optional Auth Hook: supabase functions deploy before-user-created
#   Authentication → Hooks → Before User Created → that function URL
#   supabase secrets set AUTH_HOOK_SECRET=...
#
# Extra admin (SQL editor):
#   update public.app_settings
#     set value = 'teammate@unu.edu,ayhnassef@unu.edu'
#     where key = 'bootstrap_admin_emails';
#   select public.elevate_bootstrap_admins();
#
# Rotate the anon key if this project was ever publicly reachable with open RLS.

# --- Server-only (Supabase CLI, not Vite / not Vercel frontend) ---
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# Auth checklist (Dashboard):
# 1. Authentication → Providers → Email → enabled (magic link / OTP)
# 2. Authentication → URL Configuration → Site URL = your Vercel URL
#    Redirect URLs include: http://localhost:5173/** and https://YOUR_APP.vercel.app/**
#    Do not use wildcard redirect URLs beyond those two origins.
# 3. Domain lock: security.sql installs a trigger on auth.users; optional HTTP hook above.
